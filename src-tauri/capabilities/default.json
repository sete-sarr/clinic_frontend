{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de la fenêtre principale : enregistrement et ouverture des documents téléchargés.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-mkdir",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPCACHE" }, { "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPCACHE/**" }]
    }
  ]
}
